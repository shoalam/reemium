---
import HeroBackground from '../components/home/HeroBackground.astro';
import HeroSection from '../components/home/HeroSection.astro';
import AboutSection from '../components/home/AboutSection.astro';
import SiteFooter from '../components/home/SiteFooter.astro';
import SiteHeader from '../components/home/SiteHeader.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main
		class="relative isolate flex min-h-[max(680px,100svh)] flex-col overflow-hidden border border-white/35 bg-[#170809]"
		id="top"
	>
		<HeroBackground />
		<SiteHeader />
		<HeroSection />
		<SiteFooter />
	</main>
	<AboutSection />
</Layout>
